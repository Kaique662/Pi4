# URL pública do back (ngrok). Necessária para webhook e retorno automático ao app.
API_PUBLIC_URL=
APP_SCHEME=blackwear
# Admin principal: nao pode ser excluido, rebaixado nem desativado.
MAIN_ADMIN_EMAIL=<email>
