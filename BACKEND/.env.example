# Preencha localmente; não compartilhe este arquivo com valores reais.
PORT=3000
MONGO_URI=sua_uri_do_mongodb_atlas
JWT_SECRET=gere_uma_chave_longa_e_secreta

# --- Mercado Pago (credenciais de TESTE) ---
# Sem MP_ACCESS_TOKEN o checkout continua na simulação do MVP.
MP_ACCESS_TOKEN=seu_access_token_de_teste
# Opcional no começo: chave secreta do webhook (painel do MP > Webhooks)
MP_WEBHOOK_SECRET=
# URL pública do back (ngrok). Necessária para webhook e retorno automático ao app.
API_PUBLIC_URL=
APP_SCHEME=blackwear

# Admin principal: nao pode ser excluido, rebaixado nem desativado.
MAIN_ADMIN_EMAIL=email_do_admin_principal
